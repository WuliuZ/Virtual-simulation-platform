# 复制本文件为 application.yml，并填入你本地的数据库配置
# 注意：application.yml 已在 .gitignore 中，不会被提交到仓库

# 配置项目启动端口号
server:
  port: 8080

# 配置数据源
spring:
  devtools:
    add-properties: true
    additional-paths: src/main/java
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: root
    password: your_password_here
    url: jdbc:mysql://localhost:3306/mybatist1?useUnicode=true&characterEncoding=UTF-8&zeroDateTimeBehavior=convertToNull&serverTimezone=GMT%2B8

# 配置 MyBatis 和 xml 映射
mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: cn.zhangjuntao.spring001.entity
